---
const navLinks = [
  { href: '/',         label: 'Home'        },
  { href: '/about',    label: 'About'       },
  { href: '/kombucha', label: 'Kombucha'    },
  { href: '/sobolo',   label: 'Sobolo'      },
  { href: '/salve',    label: 'Hand Salve'  },
  { href: '/updates',  label: 'Updates'     },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-forest/95 backdrop-blur-md border-b border-white/10">
  <nav class="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between h-16">

    <!-- Logo -->
    <a href="/" class="font-display text-2xl text-sun tracking-wide hover:text-sun-light transition-colors">
      Solar Blessing
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-1">
      {navLinks.map(({ href, label }) => {
        const isActive = current === href || (href !== '/' && current.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class:list={[
                'px-4 py-2 rounded-lg text-sm font-body font-medium transition-all duration-200',
                isActive
                  ? 'bg-sun text-white'
                  : 'text-white/75 hover:text-white hover:bg-white/10'
              ]}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-white/80 hover:text-white p-2 rounded-lg hover:bg-white/10 transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/10 bg-forest px-6 pb-4"
  >
    <ul class="flex flex-col gap-1 pt-3">
      {navLinks.map(({ href, label }) => {
        const isActive = current === href || (href !== '/' && current.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block px-4 py-2.5 rounded-lg text-sm font-body font-medium transition-all duration-200',
                isActive
                  ? 'bg-sun text-white'
                  : 'text-white/75 hover:text-white hover:bg-white/10'
              ]}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  const btn  = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;

  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
