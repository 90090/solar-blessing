---
import ProductLayout from '../layouts/ProductLayout.astro';
---
<ProductLayout
  product="kombucha"
  title="Kombucha"
  tagline="Invigorating Probiotic Tea"
  accentClass="bg-sun/15"
  heroImage="/images/kombucha.png"
  image="/images/kombucha2.png"
  intro="Our handcrafted kombucha is a naturally fermented tea rich in probiotics and beneficial enzymes. Each batch is carefully brewed using organic tea and our special S.C.O.B.Y. culture, resulting in a refreshing, tangy, beverage that supports gut health and overall wellness."
  whatIsIt="Kombucha is an ancient fermented beverage made from sweetened tea and a symbiotic colony of bacteria and yeast (S.C.O.B.Y). Through fermentation, beneficial probiotics are cultivated and organic digestive acids (gluconic and acetic) are produced. Kombucha is an invigorating beverage boosting digestive health and the immune system!"
  benefits={[
    'Improved gut health & digestion',
    'Increased energy & mental clarity',
    'Detoxification support',
    'Immune system boost',
    'Rich in B vitamins & antioxidants',
  ]}
  steps={[
    {
      number: '01',
      title: 'Brew Sweet Tea',
      body: 'We begin with premium organic black tea, hibiscus petals, and pure granulated sugar. Brewing a strong, sweet tea base that will fuel the fermentation process.',
    },
    {
      number: '02',
      title: 'Add S.C.O.B.Y',
      body: 'Once the blend reaches room temperature a healthy new S.C.O.B.Y is added along with a potent prebiotic starter liquid to jumpstart the first fermentation!',
    },
    {
      number: '03',
      title: 'Bottle & Ferment',
      body: 'The first fermentation lasts 14 days. The second fermentation begins with bottling the kombucha with fruit juice which introduces new sugars to ferment within the bottle, delivering a carbonating kick!',
    },
  ]}
/>
