---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarRating from '../components/StarRating';

// In production, fetch approved posts/events from your API here
// e.g. const posts = await postsApi.list();
const posts = [
  {
    id: '1',
    title: 'Spring Batch: New Ginger Turmeric Kombucha!',
    excerpt: 'We\'re excited to announce a new seasonal flavour! Our Ginger Turmeric Kombucha combines the warming spice of fresh ginger with the anti-inflammatory power of turmeric. Perfect for spring wellness.',
    createdAt: '2024-03-10T00:00:00Z',
  },
];

const events = [
  {
    id: '1',
    title: 'Downtown Farmers Market',
    date: 'Saturday, March 15',
    time: '8:00 AM – 2:00 PM',
    location: 'City Center Plaza',
    description: 'Come find us at booth #12!',
  },
  {
    id: '2',
    title: 'Wellness Fair',
    date: 'Sunday, March 23',
    time: '10:00 AM – 4:00 PM',
    location: 'Community Center',
    description: 'Sample all three products!',
  },
];

const testimonials = [
  {
    quote: 'The kombucha is incredible! I can really taste the quality and care that goes into every batch. It\'s become a staple in my daily wellness routine.',
    author: 'Sarah M.',
    rating: 5,
  },
  {
    quote: 'Hand Salve-ation saved my winter-damaged hands! I work outdoors and this is the only product that\'s actually healed my cracked skin.',
    author: 'Michael R.',
    rating: 5,
  },
];
---

<BaseLayout title="Updates & News — Solar Blessing">

  <!-- Hero -->
  <section class="bg-sun/20 grain-overlay py-24 px-6 text-center">
    <div class="max-w-3xl mx-auto space-y-4 animate-fade-up">
      <h1 class="font-display text-5xl md:text-6xl text-forest">Updates &amp; News</h1>
      <p class="font-body text-bark/60 text-lg">
        Stay connected with Solar Blessing's latest news, events, and product updates.
      </p>
    </div>
  </section>

  <!-- Events -->
  <section class="section-pad bg-white">
    <div class="container-xl">
      <h2 class="font-display text-4xl text-forest mb-10">Where to Find Us</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.map(ev => (
          <div class="card p-7 space-y-3">
            <p class="text-sun font-semibold text-sm">{ev.date}</p>
            <h3 class="font-display text-2xl text-forest">{ev.title}</h3>
            <p class="text-bark/60 text-sm flex items-center gap-2">📍 {ev.location}</p>
            <p class="text-bark/60 text-sm flex items-center gap-2">⏰ {ev.time}</p>
            <p class="text-bark/50 text-sm">{ev.description}</p>
          </div>
        ))}
        <!-- Placeholder slot for future events -->
        <div class="rounded-2xl border-2 border-dashed border-forest/20 flex items-center justify-center p-8 text-bark/30 italic text-sm">
          More events coming soon…
        </div>
      </div>
    </div>
  </section>

  <!-- Blog posts -->
  <section class="section-pad bg-cream">
    <div class="container-xl">
      <h2 class="font-display text-4xl text-forest mb-10">Recent Updates</h2>
      <div class="space-y-6">
        {posts.map(post => (
          <div class="card p-0 overflow-hidden grid md:grid-cols-[280px_1fr]">
            <div class="h-48 md:h-auto bg-sun/20 flex items-center justify-center text-6xl rounded-tl-2xl rounded-bl-2xl">
              📰
            </div>
            <div class="p-8 space-y-3">
              <p class="text-sun font-semibold text-sm">{new Date(post.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
              <h3 class="font-display text-2xl text-forest">{post.title}</h3>
              <p class="text-bark/60 leading-relaxed text-sm">{post.excerpt}</p>
              <a href="#" class="text-forest font-semibold text-sm hover:text-sun transition-colors">Read more →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-pad bg-white">
    <div class="container-xl">
      <h2 class="font-display text-4xl text-forest mb-10">What People Are Saying</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <div class="bg-sun/10 rounded-2xl p-7 space-y-4">
            <StarRating client:load value={t.rating} readonly size="sm" />
            <p class="font-body italic text-bark/80 leading-relaxed">"{t.quote}"</p>
            <p class="font-semibold text-forest text-sm">— {t.author}</p>
          </div>
        ))}
        <div class="rounded-2xl border-2 border-dashed border-earth/30 flex items-center justify-center p-8 text-bark/30 italic text-sm">
          Your testimonial here…
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
