---
// No prerender export — this page is static (the default) now. The old
// frontmatter ran Astro.url.origin + a Promise.all of fetch() calls at SSR
// time, which only worked because the page was server-rendered on every
// visit. That's gone — DreamHost can't run that logic at request time, so
// it moved into UpdatesContent.tsx, which fetches from the Lambda API
// (api.yourdomain.com) client-side after the page loads.

import BaseLayout from '../layouts/BaseLayout.astro';
import UpdatesContent from '../components/UpdatesContent';
---

<BaseLayout title="Updates & News — Solar Blessing">

  <!-- Hero -->
  <section class="bg-sun/20 grain-overlay py-24 px-6 text-center">
    <div class="max-w-3xl mx-auto space-y-4 animate-fade-up">
      <h1 class="font-display text-5xl md:text-6xl text-forest">Updates &amp; News</h1>
      <p class="font-body text-bark/60 text-lg">
        Stay connected with Solar Blessing's latest news, events, and product updates.
      </p>
    </div>
  </section>

  <UpdatesContent client:load />

</BaseLayout>
