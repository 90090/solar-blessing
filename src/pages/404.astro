---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found — Solar Blessing">
  <section class="min-h-[70vh] flex items-center justify-center px-6">
    <div class="text-center space-y-6 max-w-lg animate-fade-up">
      <div class="text-8xl">🌿</div>
      <h1 class="font-display text-6xl text-forest">404</h1>
      <p class="font-display text-2xl text-bark/70">Page not found</p>
      <p class="font-body text-bark/50 leading-relaxed">
        The page you're looking for seems to have wandered off into the garden.
        Let's get you back on track.
      </p>
      <div class="flex flex-wrap gap-4 justify-center pt-2">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/updates" class="btn-outline">See Updates</a>
      </div>
    </div>
  </section>
</BaseLayout>
