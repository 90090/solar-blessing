            <div id="reviews-list"><div class="loading-row"><div class="spinner"></div></div></div>
          </div>
        </div>

        <!-- ── Posts tab ── -->
        <div id="tab-posts">
          <div class="panel" style="margin-bottom:1.5rem;">
            <div class="panel-header">
              <span class="panel-title">Blog Posts</span>
              <select id="post-filter" onchange="loadPosts()" style="font-size:0.8rem;border:1px solid rgba(43,75,33,0.15);border-radius:0.5rem;padding:0.25rem 0.5rem;background:white;color:var(--bark);outline:none;">
                <option value="pending">Pending</option>
                <option value="approved">Approved</option>
                <option value="">All</option>
              </select>
            </div>
            <div id="posts-list"><div class="loading-row"><div class="spinner"></div></div></div>
            <div class="create-form">
