---
import { verifyAdminToken, getTokenFromCookies, securityHeaders } from '../../lib/security';

// ── Auth guard ────────────────────────────────────────────────────────────────
let adminId = '';
try {
  const token = getTokenFromCookies(Astro.request.headers.get('cookie'));
  if (!token) return Astro.redirect('/admin?error=session');
  const payload = await verifyAdminToken(token);
  adminId = payload.sub ?? 'admin';
} catch {
  return Astro.redirect('/admin?error=session');
}

Object.entries(securityHeaders()).forEach(([k, v]) => Astro.response.headers.set(k, v));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — Solar Blessing Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&display=swap" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --sun:    #f9af39;
      --sun-d:  #e09520;
      --forest: #2b4b21;
      --earth:  #774d25;
      --cream:  #faf6ed;
      --bark:   #3d2b1a;
      --white:  #ffffff;
      --radius: 1rem;
    }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--bark);
      min-height: 100vh;
      display: flex;
    }

    /* ── Sidebar ── */
    .sidebar {
      width: 240px;
      flex-shrink: 0;
      background: var(--forest);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1rem;
      position: sticky;
      top: 0;
    }
    .sidebar-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      color: var(--sun);
      padding: 0.5rem 0.75rem 1.5rem;
      letter-spacing: 0.02em;
    }
    .sidebar-logo span { display:block; font-size:0.7rem; color:rgba(255,255,255,0.4); font-family:'DM Sans',sans-serif; margin-top:2px; }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.625rem 0.75rem;
      border-radius: 0.625rem;
      color: rgba(255,255,255,0.65);
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
      transition: all 0.2s;
    }
    .nav-item:hover  { background: rgba(255,255,255,0.1); color: white; }
    .nav-item.active { background: var(--sun); color: white; }
    .nav-item .badge {
      margin-left: auto;
      background: rgba(255,255,255,0.25);
      font-size: 0.7rem;
      padding: 1px 7px;
      border-radius: 999px;
    }
    .nav-item.active .badge { background: rgba(255,255,255,0.35); }
    .sidebar-footer { margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1); }
    .logout-btn {
      display: flex; align-items: center; gap: 0.5rem;
      color: rgba(255,255,255,0.5); font-size: 0.8rem;
      background: none; border: none; cursor: pointer; padding: 0.5rem 0.75rem;
      border-radius: 0.5rem; width: 100%; transition: all 0.2s;
    }
    .logout-btn:hover { color: white; background: rgba(255,255,255,0.08); }

    /* ── Main ── */
    .main { flex: 1; overflow: auto; }
    .topbar {
      background: white;
      border-bottom: 1px solid rgba(43,75,33,0.08);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .topbar-title { font-family:'Playfair Display',serif; font-size:1.5rem; color:var(--forest); }
    .topbar-user { font-size:0.8rem; color:rgba(61,43,26,0.5); }

    .content { padding: 2rem; max-width: 1100px; }

    /* ── Stat cards ── */
    .stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:2rem; }
    .stat-card {
      background: white;
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      box-shadow: 0 2px 12px rgba(43,75,33,0.07);
    }
    .stat-label { font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:rgba(61,43,26,0.45); margin-bottom:0.375rem; }
    .stat-value { font-family:'Playfair Display',serif; font-size:2.25rem; color:var(--forest); line-height:1; }
    .stat-sub   { font-size:0.75rem; color:rgba(61,43,26,0.4); margin-top:0.25rem; }
    .stat-card.pending .stat-value { color:var(--earth); }
    .stat-card.approved .stat-value { color:var(--forest); }

    /* ── Panel ── */
    .panel {
      background: white;
      border-radius: var(--radius);
      box-shadow: 0 2px 12px rgba(43,75,33,0.07);
      overflow: hidden;
    }
    .panel-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(43,75,33,0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .panel-title { font-family:'Playfair Display',serif; font-size:1.2rem; color:var(--forest); }

    /* ── Tab view ── */
    #tab-content > div { display: none; }
    #tab-content > div.active { display: block; }

    /* ── Loading spinner ── */
    .spinner { display:inline-block; width:20px; height:20px; border:2px solid rgba(43,75,33,0.15); border-top-color:var(--forest); border-radius:50%; animation:spin 0.7s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }

    .loading-row { padding:3rem; text-align:center; color:rgba(61,43,26,0.4); font-style:italic; }

    /* ── Item cards ── */
    .item-card {
      border-bottom: 1px solid rgba(43,75,33,0.07);
      padding: 1.25rem 1.5rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 1rem;
      align-items: start;
      transition: background 0.15s;
    }
    .item-card:last-child { border-bottom: none; }
    .item-card:hover { background: rgba(249,175,57,0.03); }
    .item-meta { font-size:0.72rem; color:rgba(61,43,26,0.4); margin-bottom:0.25rem; }
    .item-title { font-weight:600; color:var(--forest); margin-bottom:0.25rem; font-size:0.95rem; }
    .item-body  { font-size:0.85rem; color:rgba(61,43,26,0.65); line-height:1.5; margin-bottom:0.5rem; max-width:580px; }
    .item-actions { display:flex; gap:0.5rem; flex-shrink:0; }

    .btn-approve {
      background: rgba(43,75,33,0.1); color:var(--forest);
      border:none; border-radius:0.5rem; padding:0.375rem 0.875rem;
      font-size:0.8rem; font-weight:600; cursor:pointer; transition:all 0.2s;
    }
    .btn-approve:hover { background:var(--forest); color:white; }
    .btn-reject {
      background: rgba(239,68,68,0.08); color:#dc2626;
      border:none; border-radius:0.5rem; padding:0.375rem 0.875rem;
      font-size:0.8rem; font-weight:600; cursor:pointer; transition:all 0.2s;
    }
    .btn-reject:hover { background:#dc2626; color:white; }
    .btn-delete {
      background: rgba(239,68,68,0.06); color:#dc2626;
      border: 1px solid rgba(239,68,68,0.2);
      border-radius:0.5rem; padding:0.375rem 0.875rem;
      font-size:0.8rem; font-weight:600; cursor:pointer; transition:all 0.2s;
    }
    .btn-delete:hover { background:#dc2626; color:white; border-color:#dc2626; }

    .badge-pill {
      display:inline-flex; align-items:center;
      font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;
      padding:2px 8px; border-radius:999px;
    }
    .badge-pending  { background:rgba(249,175,57,0.18); color:var(--earth); }
    .badge-approved { background:rgba(43,75,33,0.12);   color:var(--forest); }
    .badge-rejected { background:rgba(239,68,68,0.1);   color:#dc2626; }
    .stars-display  { color:var(--sun); font-size:0.9rem; }

    /* ── Create form ── */
    .create-form {
      padding: 1.5rem;
      border-top: 1px solid rgba(43,75,33,0.08);
      background: rgba(249,175,57,0.03);
    }
    .create-form h3 { font-family:'Playfair Display',serif; color:var(--forest); margin-bottom:1rem; font-size:1rem; }
    .form-grid { display:grid; gap:0.875rem; }
    .form-row  { display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; }
    .field label {
      display:block; font-size:0.8rem; font-weight:600; color:var(--forest); margin-bottom:0.3rem;
    }
    .field input, .field textarea, .field select {
      width:100%; background:white; border:1.5px solid rgba(43,75,33,0.15);
      border-radius:0.625rem; padding:0.625rem 0.875rem; font-size:0.875rem;
      font-family:'DM Sans',sans-serif; color:var(--bark); outline:none; transition:border-color 0.2s;
    }
    .field input:focus, .field textarea:focus, .field select:focus { border-color:var(--sun); }
    .field textarea { min-height:80px; resize:vertical; }
    .btn-create {
      background:var(--sun); color:white; border:none; border-radius:999px;
      padding:0.625rem 1.5rem; font-size:0.875rem; font-weight:600;
      cursor:pointer; transition:all 0.2s; margin-top:0.25rem;
    }
    .btn-create:hover { background:var(--sun-d); }
    .btn-create:disabled { opacity:0.6; cursor:not-allowed; }

    .empty-state {
      padding: 3rem 1.5rem; text-align:center;
      color:rgba(61,43,26,0.35); font-style:italic; font-size:0.9rem;
    }
    .success-toast {
      position:fixed; bottom:1.5rem; right:1.5rem;
      background:var(--forest); color:white;
      padding:0.875rem 1.25rem; border-radius:0.75rem;
      font-size:0.875rem; font-weight:500;
      box-shadow:0 4px 20px rgba(43,75,33,0.3);
      transform:translateY(100px); opacity:0;
      transition:all 0.3s; z-index:100;
    }
    .success-toast.show { transform:translateY(0); opacity:1; }
  </style>
</head>
<body>

  <!-- ── Sidebar ───────────────────────────────────────────────────────────── -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      Solar Blessing
      <span>Admin Dashboard</span>
    </div>

    <nav style="display:flex;flex-direction:column;gap:0.25rem;">
      <button class="nav-item active" onclick="switchTab('reviews')" id="nav-reviews">
        ⭐ Reviews <span class="badge" id="badge-reviews">…</span>
      </button>
      <button class="nav-item" onclick="switchTab('posts')" id="nav-posts">
        📝 Blog Posts <span class="badge" id="badge-posts">…</span>
      </button>
      <button class="nav-item" onclick="switchTab('events')" id="nav-events">
        📅 Events <span class="badge" id="badge-events">…</span>
      </button>
    </nav>

    <div class="sidebar-footer">
      <form action="/api/admin/logout" method="POST">
        <button type="submit" class="logout-btn">
          ← Sign Out
        </button>
      </form>
      <p style="font-size:0.7rem;color:rgba(255,255,255,0.25);padding:0.5rem 0.75rem 0;">
        Signed in as {adminId}
      </p>
    </div>
  </aside>

  <!-- ── Main ─────────────────────────────────────────────────────────────── -->
  <div class="main">
    <div class="topbar">
      <h1 class="topbar-title" id="page-title">Reviews</h1>
      <span class="topbar-user">Solar Blessing Admin</span>
    </div>

    <div class="content">

      <!-- Stats -->
      <div class="stats-row">
        <div class="stat-card pending">
          <div class="stat-label">Pending Approval</div>
          <div class="stat-value" id="stat-pending">…</div>
          <div class="stat-sub">Across all content</div>
        </div>
        <div class="stat-card approved">
          <div class="stat-label">Live on Site</div>
          <div class="stat-value" id="stat-approved">…</div>
          <div class="stat-sub">Approved content</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Total Reviews</div>
          <div class="stat-value" id="stat-reviews">…</div>
          <div class="stat-sub">All products combined</div>
        </div>
      </div>

      <!-- Tab panels -->
      <div id="tab-content">

        <!-- ── Reviews tab ── -->
        <div id="tab-reviews" class="active">
          <div class="panel">
            <div class="panel-header">
              <span class="panel-title">Customer Reviews</span>
              <div style="display:flex;gap:0.5rem;">
                <select id="review-filter" onchange="loadReviews()" style="font-size:0.8rem;border:1px solid rgba(43,75,33,0.15);border-radius:0.5rem;padding:0.25rem 0.5rem;background:white;color:var(--bark);outline:none;">
                  <option value="pending">Pending</option>
                  <option value="approved">Approved</option>
                  <option value="rejected">Rejected</option>
                  <option value="">All</option>
                </select>
              </div>
