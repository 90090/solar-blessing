              <select id="event-filter" onchange="loadEvents()" style="font-size:0.8rem;border:1px solid rgba(43,75,33,0.15);border-radius:0.5rem;padding:0.25rem 0.5rem;background:white;color:var(--bark);outline:none;">
                <option value="approved">Approved</option>
                <option value="pending">Pending</option>
                <option value="">All</option>
              </select>
            </div>
            <div id="events-list"><div class="loading-row"><div class="spinner"></div></div></div>
            <div class="create-form">
              <h3>📅 New Event</h3>
              <div class="form-grid">
                <div class="form-row">
                  <div class="field"><label>Event title</label><input type="text" id="event-title" maxlength="200" placeholder="Downtown Farmers Market" /></div>
                  <div class="field"><label>Date (e.g. Saturday, April 5)</label><input type="text" id="event-date" maxlength="80" placeholder="Saturday, April 5" /></div>
                </div>
                <div class="form-row">
                  <div class="field"><label>Time</label><input type="text" id="event-time" maxlength="80" placeholder="8:00 AM – 2:00 PM" /></div>
                  <div class="field"><label>Location</label><input type="text" id="event-location" maxlength="200" placeholder="City Center Plaza" /></div>
                </div>
                <div class="field"><label>Description</label><textarea id="event-desc" rows="2" maxlength="600" placeholder="Come find us at booth #12!"></textarea></div>
                <div><button class="btn-create" onclick="createEvent()">Add Event →</button></div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /tab-content -->
    </div><!-- /content -->
  </div><!-- /main -->

  <!-- Toast -->
  <div class="success-toast" id="toast"></div>

<script is:inline>
// ── Helpers ──────────────────────────────────────────────────────────────────

function esc(str) {
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#x27;');
}

function stars(n) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}

function fmtDate(iso) {
  try { return new Date(iso).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); }
  catch { return iso; }
}

function getCsrf() {
  const m = document.cookie.match(/csrf_token=([^;]+)/);
  return m ? m[1] : '';
}

function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 3000);
}

async function apiFetch(path, opts = {}) {
  const csrf = getCsrf();
  const res = await fetch(path, {
    ...opts,
    credentials: 'include',
    headers: { 'Content-Type':'application/json', 'X-CSRF-Token': csrf, ...(opts.headers ?? {}) },
  });
  if (!res.ok) {
    const d = await res.json().catch(() => ({}));
    throw new Error(d.message ?? `HTTP ${res.status}`);
  }
  if (res.status === 204) return null;
  return res.json();
}

// ── Tab switching ─────────────────────────────────────────────────────────────

const tabTitles = { reviews:'Reviews', posts:'Blog Posts', events:'Events' };

function switchTab(tab) {
  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('#tab-content > div').forEach(d => d.classList.remove('active'));
  document.getElementById('nav-' + tab).classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
  document.getElementById('page-title').textContent = tabTitles[tab];
  if (tab === 'reviews') loadReviews();
  if (tab === 'posts')   loadPosts();
  if (tab === 'events')  loadEvents();
}

// ── Stats ─────────────────────────────────────────────────────────────────────

async function loadStats() {
  try {
    const s = await apiFetch('/api/admin/stats');
    document.getElementById('stat-pending').textContent  = s.pendingReviews + s.pendingPosts + s.pendingEvents;
    document.getElementById('stat-approved').textContent = s.approvedReviews + s.approvedPosts + s.approvedEvents;
    document.getElementById('stat-reviews').textContent  = s.approvedReviews + s.pendingReviews;
    document.getElementById('badge-reviews').textContent = s.pendingReviews;
    document.getElementById('badge-posts').textContent   = s.pendingPosts;
    document.getElementById('badge-events').textContent  = s.pendingEvents;
  } catch(e) {
    console.error('Stats load failed', e);
  }
}

// ── Reviews ───────────────────────────────────────────────────────────────────

async function loadReviews() {
  const status = document.getElementById('review-filter').value;
  const el = document.getElementById('reviews-list');
  el.innerHTML = '<div class="loading-row"><div class="spinner"></div></div>';
  try {
    const items = await apiFetch(`/api/admin/reviews${status ? '?status=' + status : ''}`);
    if (!items.length) { el.innerHTML = '<div class="empty-state">No reviews found.</div>'; return; }
    el.innerHTML = items.map(r => `
      <div class="item-card" id="review-${esc(r.id)}">
        <div>
          <div class="item-meta">
            <span class="badge-pill badge-${esc(r.status)}">${esc(r.status)}</span>
            &nbsp;${esc(r.product)} &bull; ${fmtDate(r.createdAt)}
          </div>
          <div class="item-title">${esc(r.name)} &nbsp;<span class="stars-display">${stars(r.rating)}</span></div>
          <div class="item-body">${esc(r.body)}</div>
        </div>
        <div class="item-actions">
          ${r.status !== 'approved' ? `<button class="btn-approve" onclick="moderateReview('${esc(r.id)}','approve')">Approve</button>` : ''}
          ${r.status !== 'rejected' ? `<button class="btn-reject"  onclick="moderateReview('${esc(r.id)}','reject')">Reject</button>`  : ''}
          <button class="btn-delete" onclick="deleteReview('${esc(r.id)}')">Delete</button>
        </div>
      </div>`).join('');
  } catch(e) {
    el.innerHTML = `<div class="empty-state" style="color:#dc2626;">Failed to load reviews: ${esc(e.message)}</div>`;
  }
}

async function moderateReview(id, action) {
  try {
    await apiFetch(`/api/admin/reviews/${id}`, { method:'PATCH', body: JSON.stringify({ action }) });
    toast(action === 'approve' ? '✅ Review approved and live!' : '🚫 Review rejected.');
    loadReviews(); loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

async function deleteReview(id) {
  if (!confirm('Permanently delete this review?')) return;
  try {
    await apiFetch(`/api/admin/reviews/${id}`, { method:'DELETE' });
    document.getElementById('review-' + id)?.remove();
    toast('🗑️ Review deleted.');
    loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

// ── Posts ─────────────────────────────────────────────────────────────────────

async function loadPosts() {
  const status = document.getElementById('post-filter').value;
  const el = document.getElementById('posts-list');
  el.innerHTML = '<div class="loading-row"><div class="spinner"></div></div>';
  try {
    const items = await apiFetch(`/api/admin/posts${status ? '?status=' + status : ''}`);
    if (!items.length) { el.innerHTML = '<div class="empty-state">No posts found.</div>'; return; }
    el.innerHTML = items.map(p => `
      <div class="item-card" id="post-${esc(p.id)}">
        <div>
          <div class="item-meta">
            <span class="badge-pill badge-${esc(p.status)}">${esc(p.status)}</span>
            &nbsp;${fmtDate(p.createdAt)}
          </div>
          <div class="item-title">${esc(p.title)}</div>
          <div class="item-body">${esc(p.excerpt)}</div>
        </div>
        <div class="item-actions">
          ${p.status !== 'approved' ? `<button class="btn-approve" onclick="moderatePost('${esc(p.id)}','approve')">Approve</button>` : ''}
          ${p.status !== 'rejected' ? `<button class="btn-reject"  onclick="moderatePost('${esc(p.id)}','reject')">Reject</button>`  : ''}
          <button class="btn-delete" onclick="deletePost('${esc(p.id)}')">Delete</button>
        </div>
      </div>`).join('');
  } catch(e) {
    el.innerHTML = `<div class="empty-state" style="color:#dc2626;">Failed to load posts: ${esc(e.message)}</div>`;
  }
}

async function createPost() {
  const title   = document.getElementById('post-title').value.trim();
  const excerpt = document.getElementById('post-excerpt').value.trim();
  const body    = document.getElementById('post-body').value.trim();
  if (!title || !body) { toast('⚠️ Title and body are required.'); return; }
  try {
    await apiFetch('/api/admin/posts', { method:'POST', body: JSON.stringify({ title, excerpt, body }) });
    toast('✅ Post created!');
    document.getElementById('post-title').value   = '';
    document.getElementById('post-excerpt').value = '';
    document.getElementById('post-body').value    = '';
    document.getElementById('post-filter').value  = 'approved';
    loadPosts(); loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

async function moderatePost(id, action) {
  try {
    await apiFetch(`/api/admin/posts/${id}`, { method:'PATCH', body: JSON.stringify({ action }) });
    toast(action === 'approve' ? '✅ Post is now live!' : '🚫 Post rejected.');
    loadPosts(); loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

async function deletePost(id) {
  if (!confirm('Permanently delete this post?')) return;
  try {
    await apiFetch(`/api/admin/posts/${id}`, { method:'DELETE' });
    document.getElementById('post-' + id)?.remove();
    toast('🗑️ Post deleted.');
    loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

// ── Events ────────────────────────────────────────────────────────────────────

async function loadEvents() {
  const status = document.getElementById('event-filter').value;
  const el = document.getElementById('events-list');
  el.innerHTML = '<div class="loading-row"><div class="spinner"></div></div>';
  try {
    const items = await apiFetch(`/api/admin/events${status ? '?status=' + status : ''}`);
    if (!items.length) { el.innerHTML = '<div class="empty-state">No events found.</div>'; return; }
    el.innerHTML = items.map(ev => `
      <div class="item-card" id="event-${esc(ev.id)}">
        <div>
          <div class="item-meta">
            <span class="badge-pill badge-${esc(ev.status)}">${esc(ev.status)}</span>
            &nbsp;${esc(ev.date)} &bull; ${esc(ev.time)}
          </div>
          <div class="item-title">${esc(ev.title)}</div>
          <div class="item-body">📍 ${esc(ev.location)} &mdash; ${esc(ev.description)}</div>
        </div>
        <div class="item-actions">
          ${ev.status !== 'approved' ? `<button class="btn-approve" onclick="moderateEvent('${esc(ev.id)}','approve')">Approve</button>` : ''}
          ${ev.status !== 'rejected' ? `<button class="btn-reject"  onclick="moderateEvent('${esc(ev.id)}','reject')">Reject</button>`  : ''}
          <button class="btn-delete" onclick="deleteEvent('${esc(ev.id)}')">Delete</button>
        </div>
      </div>`).join('');
  } catch(e) {
    el.innerHTML = `<div class="empty-state" style="color:#dc2626;">Failed to load events: ${esc(e.message)}</div>`;
  }
}

async function createEvent() {
  const title    = document.getElementById('event-title').value.trim();
  const date     = document.getElementById('event-date').value.trim();
  const time     = document.getElementById('event-time').value.trim();
  const location = document.getElementById('event-location').value.trim();
  const description = document.getElementById('event-desc').value.trim();
  if (!title || !date || !location) { toast('⚠️ Title, date, and location are required.'); return; }
  try {
    await apiFetch('/api/admin/events', { method:'POST', body: JSON.stringify({ title, date, time, location, description }) });
    toast('✅ Event added!');
    ['event-title','event-date','event-time','event-location','event-desc'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('event-filter').value = 'approved';
    loadEvents(); loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

async function moderateEvent(id, action) {
  try {
    await apiFetch(`/api/admin/events/${id}`, { method:'PATCH', body: JSON.stringify({ action }) });
    toast(action === 'approve' ? '✅ Event is now live!' : '🚫 Event rejected.');
    loadEvents(); loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

async function deleteEvent(id) {
  if (!confirm('Permanently delete this event?')) return;
  try {
    await apiFetch(`/api/admin/events/${id}`, { method:'DELETE' });
    document.getElementById('event-' + id)?.remove();
    toast('🗑️ Event deleted.');
    loadStats();
  } catch(e) { toast('❌ Error: ' + e.message); }
}

// ── Init ──────────────────────────────────────────────────────────────────────
loadStats();
loadReviews();
</script>
