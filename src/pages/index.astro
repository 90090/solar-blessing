---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-forest grain-overlay min-h-[88vh] flex items-center">
    <!-- Background sunburst decoration -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute right-0 top-0 w-[600px] h-[600px] bg-sun/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
      <div class="absolute left-0 bottom-0 w-[400px] h-[400px] bg-earth/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 md:px-12 lg:px-20 w-full py-24 grid lg:grid-cols-2 gap-16 items-center">
      <!-- Copy -->
      <div class="space-y-8 animate-fade-up">
        <div class="inline-flex items-center gap-2 bg-sun/20 text-sun px-4 py-1.5 rounded-full text-sm font-semibold">
          <span class="w-2 h-2 bg-sun rounded-full animate-pulse"></span>
          Handcrafted &amp; All-Natural
        </div>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white leading-tight">
          Holistic Health,<br/>
          <em class="text-sun not-italic">Naturally</em><br/>
          Crafted
        </h1>
        <p class="font-body text-white/70 text-lg md:text-xl max-w-md leading-relaxed">
          Handcrafted Kombucha, Sobolo, and healing Hand Salve-ation.
          Nourish your body with the power of nature.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/kombucha" class="btn-primary">Explore Products</a>
          <a href="/about"    class="btn-outline !border-white/40 !text-white hover:!bg-white/10">Our Story</a>
        </div>
      </div>

      <!-- Product cards preview -->
      <div class="grid grid-cols-3 gap-4 animate-fade-up" style="animation-delay:0.15s">
        {[
          { href: '/kombucha', label: 'Kombucha',         sub: 'Probiotic Elixir',     color: 'border-sun/50 bg-sun/10',       icon: '🍵' },
          { href: '/sobolo',   label: 'Sobolo',            sub: 'Hibiscus Drink',       color: 'border-forest-light/50 bg-forest-light/10 !bg-white/10 !border-white/20', icon: '🌺' },
          { href: '/salve',    label: 'Hand Salve-ation',  sub: 'Healing Balm',         color: 'border-earth/50 bg-earth/10',   icon: '✋' },
        ].map(p => (
          <a
            href={p.href}
            class:list={[
              'group flex flex-col items-center gap-3 p-5 rounded-2xl border-2 transition-all duration-300',
              'hover:-translate-y-2 hover:shadow-warm',
              p.color,
            ]}
          >
            <span class="text-4xl">{p.icon}</span>
            <span class="font-display text-white text-sm text-center leading-tight">{p.label}</span>
            <span class="text-white/50 text-xs text-center">{p.sub}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why Solar Blessing ────────────────────────────────────────────────── -->
  <section class="section-pad bg-cream">
    <div class="container-xl">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-5xl text-forest mb-4">Made with Intention</h2>
        <p class="font-body text-bark/60 text-lg max-w-2xl mx-auto">
          Every product is crafted by hand using traditional methods and the finest natural ingredients.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          { icon: '🌿', title: '100% Natural',   body: 'Zero artificial ingredients. Every recipe starts with whole-food inputs sourced from trusted suppliers.' },
          { icon: '🫙', title: 'Handcrafted',     body: 'Small batches, made with care. Each jar, bottle, and tin gets our full attention from start to finish.' },
          { icon: '♻️', title: 'Sustainable',     body: 'Earth-first packaging, minimal waste, and practices that give back more than they take.' },
        ].map(v => (
          <div class="card p-8 text-center space-y-4">
            <span class="text-5xl block">{v.icon}</span>
            <h3 class="font-display text-2xl text-forest">{v.title}</h3>
            <p class="font-body text-bark/60 leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Products strip ────────────────────────────────────────────────────── -->
  <section class="section-pad bg-white">
    <div class="container-xl">
      <h2 class="font-display text-4xl md:text-5xl text-forest mb-12">Our Products</h2>
      <div class="grid md:grid-cols-3 gap-10">
        {[
          { href: '/kombucha', name: 'Kombucha',        sub: 'Probiotic-rich fermented tea',    color: 'bg-sun/15',    accent: '#f9af39' },
          { href: '/sobolo',   name: 'Sobolo',           sub: 'Refreshing hibiscus drink',       color: 'bg-forest/10', accent: '#2b4b21' },
          { href: '/salve',    name: 'Hand Salve-ation', sub: 'Natural healing hand balm',       color: 'bg-earth/10',  accent: '#774d25' },
        ].map(p => (
          <a href={p.href} class="card group overflow-visible">
            <div class:list={['h-52 rounded-t-2xl flex items-center justify-center text-7xl', p.color]}>
              {p.href === '/kombucha' ? '🍵' : p.href === '/sobolo' ? '🌺' : '✋'}
            </div>
            <div class="p-6 space-y-2">
              <h3 class="font-display text-2xl text-forest">{p.name}</h3>
              <p class="text-bark/60 font-body text-sm">{p.sub}</p>
              <span
                class="inline-block mt-3 text-sm font-semibold transition-all duration-200 group-hover:translate-x-1"
                style={`color: ${p.accent}`}
              >
                Learn more →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
