---
import ProductLayout from '../layouts/ProductLayout.astro';
---
<ProductLayout
  product="salve"
  title="Hand Salve-ation"
  tagline="Soothing Hand Salve"
  heroImage="/images/handsalve.webp"
  image="/images/handsalve2.webp"
  accentClass="bg-earth/10"
  intro="Our Hand Salve-ation is a deeply nourishing salve crafted with organic shea butter, beeswax, and essential oils. Perfect for dry or rugged hands that have been hard at work and need a nourishing rest. This salve provides intense moisture and protection while promoting skin rejuvenation."
  whatIsIt="Inspired by skin repair solutions for rock climbing, Hand Salve-ation seeks beyond hydrating skin but reinforcing skin to endure. Infused with shea butter and beeswax, it soothes irritation and accelerates healing naturally."
  benefits={[
    'Deep moisturisation & hydration',
    'Heals cracked and damaged skin',
    'Anti-inflammatory properties',
    'Protects against environmental damage',
    '100% natural, no synthetic chemicals',
  ]}
  steps={[
    {
      number: '01',
      title: 'Melt Beeswax & Shea Butter',
      body: 'We blend in organic beeswax for protection and shea butter for deep nourishment, creating the perfect texture that melts into skin without greasiness.',
    },
    {
      number: '02',
      title: 'Add Essential Oils',
      body: 'We slowly infuse organic olive oil with dried calendula, comfrey, and plantain herbs over gentle heat for several hours, extracting their healing properties.',
    },
  ]}
/>
