---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Solar Blessing — Holistic Health, Naturally Crafted',
  description = 'Handcrafted Kombucha, Sobolo, and healing Hand Salve-ation. Nourish your body with the power of nature.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Security meta tags -->
  <!-- DreamHost serves plain static files — there's no server-side request
       handler here to inject response headers the way securityHeaders() does
       on the Lambda side, so CSP has to be set via meta tag instead.
       connect-src includes the API origin since pages now fetch cross-origin
       to api.yourdomain.com for reviews/posts/events/csrf — replace with
       your actual API subdomain before deploying. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.solarblessings.com; img-src 'self' data:; frame-ancestors 'none';" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="X-Frame-Options" content="DENY" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <!-- Google Fonts loaded via link (not CSS @import — avoids postcss-import conflict) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap"
  />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen flex flex-col">
  <Nav />
  <main class="flex-1">
    <slot />
  </main>
  <footer class="bg-forest text-white py-10 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <span class="font-display text-xl text-sun tracking-wide">Solar Blessing</span>
      <p class="text-white/60 text-sm font-body">
        © {new Date().getFullYear()} Solar Blessing. All rights reserved.
      </p>
      <div class="flex gap-6 text-sm text-white/60">
        <a href="/updates" class="hover:text-sun transition-colors">Updates</a>
        <a href="/about" class="hover:text-sun transition-colors">About</a>
      </div>
    </div>
  </footer>
</body>
</html>
